            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(http_request_duration_seconds_count{service=~\"$service.*\", path=~\"$path\", status_code=~\"5..\"}[$__rate_interval])) / sum(rate(http_request_duration_seconds_count{service=~\"$service.*\", path=~\"$path\"}[$__rate_interval]))"
        }
      ]
    },
