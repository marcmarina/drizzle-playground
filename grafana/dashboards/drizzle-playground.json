        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (method, path, status_code) (rate(http_request_duration_seconds_count{service=~\"$service.*\", path=~\"$path\", status_code=~\"[45]..\"}[$__rate_interval]))",
          "legendFormat": "{{status_code}} {{method}} {{path}}"
        }
      ]
    }
