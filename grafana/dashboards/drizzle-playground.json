        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, method, path) (rate(http_request_duration_seconds_bucket{service=~\"$service.*\", path=~\"$path\"}[$__rate_interval])))",
          "legendFormat": "{{method}} {{path}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "p99 latency by path",
      "gridPos": {
        "x": 12,
